rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email;
    }

    function isOwner() {
      return signedIn() && email() == 'infojr.83@gmail.com';
    }

    function isBarbara() {
      return signedIn() && email() == 'barbara.kalchik8reserve@gmail.com';
    }

    function isSuperAdmin() {
      return isOwner() || isBarbara();
    }

    function isApprovedRegularAdminEmail() {
      return signedIn() && (
        email() == 'april.grantham@hotelplanner.com'
        || email() == 'jim.fryer@hotelplanner.com'
        || email() == 'karen.caldas@hotelplanner.com'
      );
    }

    function isBuiltInAdminEmail(userEmail) {
      return userEmail == 'infojr.83@gmail.com'
        || userEmail == 'barbara.kalchik8reserve@gmail.com'
        || userEmail == 'april.grantham@hotelplanner.com'
        || userEmail == 'jim.fryer@hotelplanner.com'
        || userEmail == 'karen.caldas@hotelplanner.com';
    }

    function isSuperAdminEmail(userEmail) {
      return userEmail == 'infojr.83@gmail.com'
        || userEmail == 'barbara.kalchik8reserve@gmail.com';
    }

    function isRegularAdminEmail(userEmail) {
      return userEmail == 'april.grantham@hotelplanner.com'
        || userEmail == 'jim.fryer@hotelplanner.com'
        || userEmail == 'karen.caldas@hotelplanner.com';
    }

    function regularAdminProfileExists() {
      return exists(/databases/$(database)/documents/users/$(email()));
    }

    function regularAdminIsActive() {
      return !regularAdminProfileExists()
        || get(/databases/$(database)/documents/users/$(email())).data.active != false;
    }

    function isAdmin() {
      return isSuperAdmin()
        || (isApprovedRegularAdminEmail() && regularAdminIsActive());
    }

    function ownAccess() {
      return get(/databases/$(database)/documents/users/$(email())).data;
    }

    function canSubmit() {
      return isAdmin() || (
        signedIn()
        && ownAccess().active == true
        && ownAccess().role == 'evaluator'
        && ownAccess().permissions.canSubmitReviews == true
      );
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if canSubmit();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['emailSent', 'emailSentAt', 'emailSentBy', 'updatedAt']);
      allow delete: if isOwner();
    }

    match /users/{userEmail} {
      allow get: if signedIn() && (email() == userEmail || isAdmin());
      allow list: if isAdmin();

      // Junior and Barbara can manage the team, but both Super Admin accounts
      // are protected from demotion or blocking.
      allow create: if (
        isSuperAdmin()
        && (
          !isSuperAdminEmail(userEmail)
          || (
            request.resource.data.role == 'admin'
            && request.resource.data.active == true
          )
        )
      ) || (
        isApprovedRegularAdminEmail()
        && email() == userEmail
        && isRegularAdminEmail(userEmail)
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
      ) || (
        isAdmin()
        && !isBuiltInAdminEmail(userEmail)
        && request.resource.data.role != 'admin'
      );

      allow update: if (
        isSuperAdmin()
        && (
          !isSuperAdminEmail(userEmail)
          || (
            request.resource.data.role == 'admin'
            && request.resource.data.active == true
          )
        )
        && (
          !isRegularAdminEmail(userEmail)
          || request.resource.data.role == 'admin'
        )
      ) || (
        isApprovedRegularAdminEmail()
        && isAdmin()
        && email() == userEmail
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
      ) || (
        isAdmin()
        && !isBuiltInAdminEmail(userEmail)
        && request.resource.data.role != 'admin'
      );

      allow delete: if isOwner()
        && !isBuiltInAdminEmail(userEmail);
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /meta/{metaId} {
      allow read: if signedIn();
      allow create, update: if canSubmit();
      allow delete: if isOwner();
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.actorEmail == email();
      allow update, delete: if false;
    }

    match /watchListAgents/{agentId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
